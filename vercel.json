{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": ".",
  "installCommand": "",
  "redirects": [
    { "source": "/", "destination": "/index.html", "permanent": false },
    { "source": "/work.html", "destination": "/share/work.html", "permanent": false },
    { "source": "/about.html", "destination": "/share/about.html", "permanent": false },
    { "source": "/share", "destination": "/share/work.html", "permanent": false },
    { "source": "/share/", "destination": "/share/work.html", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/case-studies/points-marketplace-foundational/regenerated/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    },
    {
      "source": "/assets/case-study-card-gallery.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/case-study-card-gallery.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/index-marble.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
